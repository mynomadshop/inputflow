<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography -->
    <Style x:Key="Heading1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="Heading2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="BodyTextSecondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <!-- Odometer display — main visual anchor -->
    <Style x:Key="OdometerDisplay" TargetType="TextBlock">
        <Setter Property="FontSize" Value="64" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
    </Style>

    <!-- Counter display -->
    <Style x:Key="CounterDisplay" TargetType="TextBlock">
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AccentAltBrush}" />
    </Style>

    <!-- Card surface -->
    <Style x:Key="CardSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <!-- Elevated card surface -->
    <Style x:Key="ElevatedCardSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="48,32" />
    </Style>

</ResourceDictionary>
