<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InputFlow.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="24">
            
            <TextBlock Text="History" Style="{StaticResource Heading2}" />

            <!-- Date range selector -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="From:" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                    <DatePicker x:Name="StartDatePicker" Grid.Column="1" HorizontalAlignment="Left" />
                    
                    <TextBlock Text="To:" VerticalAlignment="Center" Grid.Column="2" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,12,0" />
                    <DatePicker x:Name="EndDatePicker" Grid.Column="3" HorizontalAlignment="Left" />
                </Grid>
            </Border>

            <!-- Daily summary table -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="4">
                <ScrollViewer VerticalScrollMode="Enabled">
                    <DataGrid x:Name="HistoryTable" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserResizeRows="False"
                              Background="{StaticResource SurfaceBrush}"
                              Foreground="{StaticResource TextBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}" Width="120" />
                            <DataGridTextColumn Header="Key Presses" Binding="{Binding KeyPresses}" Width="120" 
                                                FontFamily="Consolas" />
                            <DataGridTextColumn Header="Distance" Binding="{Binding DistanceDisplay}" Width="140" 
                                                FontFamily="Consolas" />
                            <DataGridTextColumn Header="Quality" Binding="{Binding QualityLabel}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
